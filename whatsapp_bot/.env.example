#
# Twilio WhatsApp bot config
#
# Your Twilio Account SID / Auth Token (used only for optional signature validation;
# the bot mainly needs webhook access to Twilio).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Base URL of your existing analysis API (FastAPI/your backend).
# Example: http://127.0.0.1:9000
API_BASE_URL=http://127.0.0.1:9000

# Flask port (optional)
PORT=5000

# MongoDB Atlas connection string
# Use a mongodb+srv://... URI from your Atlas dashboard.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Optional: override db name (if your URI doesn't include one cleanly)
MONGODB_DB=phishbot

# Optional: which collection to store reports in
MONGODB_COLLECTION=reports

# Logging
LOG_LEVEL=INFO

